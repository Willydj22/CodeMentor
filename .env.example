# Copia a .env (local) o define estas variables en tu hosting.
# Si tu hosting no permite variables de entorno, usa config.local.php.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codementor
DB_USER=
DB_PASS=

# Motor principal de IA
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash

# Respaldo (una cuenta por clave = cuota independiente)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODELO=openai/gpt-oss-120b

# Panel de administración (estado.php): usa el hash, no texto plano
#   php -r "echo password_hash('tu-contraseña', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Opcionales (cada función se desactiva si falta su clave)
YOUTUBE_API_KEY=
SERPAPI_KEY=
SUPADATA_API_KEY=
CONTEXT_DEV_API_KEY=
PIXABAY_API_KEY=
VOICERSS_API_KEY=
REMOVE_BG_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
