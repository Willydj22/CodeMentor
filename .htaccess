# Nunca servir archivos de configuración, logs ni SQL
<FilesMatch "^(config\.local\.php|config\.local\.example\.php|\.env.*|schema\.sql)$|\.log$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
